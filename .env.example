FLASK_APP=wsgi.py
FLASK_DEBUG=1
# macOS binds AirPlay Receiver to 5000 by default, so this project runs on 8000 instead.
FLASK_RUN_PORT=8000

SECRET_KEY=change-me
JWT_SECRET_KEY=change-me

# Supabase Postgres connection string, e.g.:
# postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
# Leave unset to fall back to a local SQLite file for quick local dev.
DATABASE_URL=

CORS_ORIGINS=http://localhost:3000,http://app.localhost:3000

# Emails (aviso de consultas a la agencia, confirmación al cliente, e
# invitaciones de equipo) vía Resend. Sin RESEND_API_KEY, los emails solo se
# escriben en el log.
RESEND_API_KEY=
# Remitente: el dominio tiene que estar verificado en Resend.
EMAIL_FROM=Tivvo <avisos@tudominio.com>
# Dashboard (vive en el subdominio app., ver frontend/src/proxy.ts) vs.
# páginas públicas para el cliente final (reserva/oferta, sitio de la
# agencia), que viven en el dominio raíz.
FRONTEND_URL=http://app.localhost:3000
PUBLIC_SITE_URL=http://localhost:3000
