FLASK_APP=wsgi.py
FLASK_DEBUG=1
# macOS binds AirPlay Receiver to 5000 by default, so this project runs on 8000 instead.
FLASK_RUN_PORT=8000

SECRET_KEY=change-me
JWT_SECRET_KEY=change-me

# Supabase Postgres connection string, e.g.:
# postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
# Leave unset to fall back to a local SQLite file for quick local dev.
DATABASE_URL=

CORS_ORIGINS=http://localhost:3000,http://app.localhost:3000

# Emails (aviso de consultas a la agencia, confirmación al cliente, e
# invitaciones de equipo) vía Resend. Sin RESEND_API_KEY, los emails solo se
# escriben en el log.
RESEND_API_KEY=
# Remitente: el dominio tiene que estar verificado en Resend.
EMAIL_FROM=Tivvu <avisos@tudominio.com>
# Dashboard (vive en el subdominio app., ver frontend/src/proxy.ts) vs.
# páginas públicas para el cliente final (reserva/oferta, sitio de la
# agencia), que viven en el dominio raíz.
FRONTEND_URL=http://app.localhost:3000
PUBLIC_SITE_URL=http://localhost:3000

# Quién recibe los pedidos de demo y de contacto/ayuda del landing.
TEAM_NOTIFICATION_EMAILS=facugirardi22@gmail.com,alejo.voyrnet31@gmail.com

# Local development only: lets the property importer read a feed served from
# localhost (it blocks internal addresses otherwise). Never set in production.
# IMPORT_ALLOW_PRIVATE_URLS=1

# Suscripciones con Paddle (vende por nosotros: cobra, factura y maneja los impuestos).
# Sin BILLING_ENABLED=1 nadie paga: la cuenta nueva arranca con acceso directo
# (desarrollo local). En producción dejarlo en 1: una agencia sin tarjeta queda
# bloqueada hasta elegir plan.
BILLING_ENABLED=0
# "sandbox" (cuenta de prueba) o "production"
PADDLE_ENV=sandbox
# Clave de servidor (pdl_...): Developer tools > Authentication > API keys.
PADDLE_API_KEY=
# Token público para Paddle.js en el navegador (test_... / live_...): Authentication > Client-side tokens.
PADDLE_CLIENT_TOKEN=
# Firma de los eventos que Paddle manda a POST /api/billing/webhook (Developer tools > Notifications).
# Eventos: subscription.created, subscription.activated, subscription.trialing,
# subscription.updated, subscription.past_due, subscription.paused,
# subscription.resumed y subscription.canceled.
PADDLE_WEBHOOK_SECRET=
# Precio mensual de Pro (pri_...) y el mismo precio con prueba gratis de 14 días que pide tarjeta (pri_...).
PADDLE_PRICE_PRO=
PADDLE_PRICE_TRIAL=
